# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values

DATABASE_URL="file:./dev.db"

# Get these from https://dashboard.clerk.com (REQUIRED)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Generate a random 32-character string for encryption (REQUIRED)
# Run: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_SECRET=

# Optional: For AI extraction feature
OPENAI_API_KEY=

# For Vercel deployment, you MUST set this to a remote browser service
# Get from: BrightData, Browserless.io, or Apify
BROWSER_WS_ENDPOINT=

# Local development settings
PUPPETEER_HEADLESS=false
PUPPETEER_TIMEOUT=30000
NEXT_PUBLIC_APP_URL=http://localhost:3000
